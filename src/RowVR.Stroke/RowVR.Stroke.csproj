<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the SAME files Unity compiles. The sources live under Assets/ because Unity
    must own them; this project links them in so the identical code can be built and tested
    with nothing but the .NET SDK - no Unity install, no licence, no headset. That is what
    makes tier 1 of the dev loop possible, and what lets these tests run in CI.

    If this ever needs a PackageReference, stop: this assembly must stay dependency-free so
    Unity can compile it too.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RowVR.Stroke</AssemblyName>
    <RootNamespace>RowVR.Stroke</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../Assets/Scripts/Stroke/**/*.cs" />
  </ItemGroup>

</Project>
